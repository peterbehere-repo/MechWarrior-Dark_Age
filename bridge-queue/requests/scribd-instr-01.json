{
 "id": "scribd-instr-01",
 "mode": "interact",
 "url": "https://www.scribd.com/document/733661340/Dark-Age-Campaigns",
 "settleMs": 5000,
 "steps": [
  {
   "act": "pause",
   "ms": 7000
  },
  {
   "act": "js",
   "expr": "(()=>{const es=performance.getEntriesByType('resource').map(e=>e.name).filter(n=>/scribd/.test(n));return JSON.stringify({n:es.length,urls:Array.from(new Set(es)).slice(0,150)})})()"
  },
  {
   "act": "js",
   "expr": "(()=>{const ks=Object.keys(window).filter(k=>/doc|page|read|scribd|view/i.test(k));return JSON.stringify(ks)})()"
  },
  {
   "act": "scroll",
   "y": 1500
  },
  {
   "act": "pause",
   "ms": 4000
  },
  {
   "act": "scroll",
   "y": 3000
  },
  {
   "act": "pause",
   "ms": 4000
  },
  {
   "act": "js",
   "expr": "(()=>{const s=new Set();document.querySelectorAll('img').forEach(i=>{const u=(i.currentSrc||i.src||'');if(u)s.add(u)});const es=performance.getEntriesByType('resource').map(e=>e.name).filter(n=>/scribd/.test(n));return JSON.stringify({imgs:Array.from(s).slice(0,200),res:Array.from(new Set(es)).slice(0,150)})})()"
  }
 ]
}