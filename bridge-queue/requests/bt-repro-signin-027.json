  },
  {
   "act": "js",
   "expr": "(()=>{const e=document.querySelector('#auth-submit');const r=e?e.getBoundingClientRect():null;\n return JSON.stringify({open:document.querySelector('#auth-dialog').open,\n rect:r?{x:r.x,y:r.y,w:r.width,h:r.height}:null,\n visible:e?getComputedStyle(e).visibility+'/'+getComputedStyle(e).display:'missing',\n count:document.querySelectorAll('#auth-submit').length,\n active:document.activeElement&&document.activeElement.id,\n typed:document.querySelector('#auth-ra-user').value+'|'+document.querySelector('#auth-ra-key').value.length})})()"
