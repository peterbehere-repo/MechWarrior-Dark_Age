{"id": "contra-sheet-list-002", "type": "interact", "url": "https://www.spriters-resource.com/nes/contra/", "steps": [{"act": "wait", "selector": "body", "timeoutMs": 15000}, {"act": "pause", "ms": 12000}, {"act": "js", "expr": "(()=>{const t=document.title;const links=[...document.querySelectorAll('a[href*=asset]')].map(a=>a.href+' | '+a.textContent.trim()).slice(0,60).join('\\n');return 'TITLE:'+t+'\\n'+links})()"}]}