{
  "id": "heat-tips-verify-002",
  "mode": "interact",
  "url": "https://raw.githack.com/peterbehere-repo/MechWarrior-Dark_Age/battletech-queue/mocks/heat-tips-verify.html",
  "settleMs": 1200,
  "steps": [
    {"act": "clickText", "selector": "button", "text": "Open the page", "optional": true},
    {"act": "wait", "selector": ".cell", "timeoutMs": 8000, "optional": true},
    {"act": "pause", "ms": 1000},
    {"act": "js", "expr": "(() => { const cs=[...document.querySelectorAll('.cell')].slice(0,6).map(c=>c.title); return JSON.stringify({count:cs.length, titles:cs}); })()"}
  ]
}
